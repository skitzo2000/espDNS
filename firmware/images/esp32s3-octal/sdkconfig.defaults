# ESP32-S3 with octal PSRAM (S3R8, S3R16V): XIAO ESP32S3 Sense, and any S3 on Wi-Fi.
# A wired S3 runs esp32s3-eth: this, with speed bought with internal RAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
